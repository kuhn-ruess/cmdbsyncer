#!/usr/bin/env bash
# Simple Helper for CMDB Syncer dev jobs.
#
# Auto-detects the container runtime (docker preferred, podman fallback).
# Override with CONTAINER_RUNTIME=docker or CONTAINER_RUNTIME=podman.
set -euo pipefail

PROJECT=cmdb_syncer
APPLICATION=cmdb_syncer-api-1

RUNTIME="${CONTAINER_RUNTIME:-}"
if [ -z "$RUNTIME" ]; then
    if command -v docker >/dev/null 2>&1; then
        RUNTIME=docker
    elif command -v podman >/dev/null 2>&1; then
        RUNTIME=podman
    else
        echo "Neither docker nor podman found on PATH." >&2
        exit 1
    fi
fi

case "$RUNTIME" in
    docker) COMPOSE=(docker compose) ;;
    podman) COMPOSE=(podman-compose) ;;
    *) echo "Unsupported CONTAINER_RUNTIME: $RUNTIME" >&2; exit 1 ;;
esac

compose() {
    "${COMPOSE[@]}" -f docker-compose.yml -f docker-compose.local.yml -p "$PROJECT" "$@"
}

case "${1:-}" in
"up")
    # -f: without it "rm" asks for confirmation, which nobody can answer
    # when the stack is being brought up in the background.
    compose rm -f
    # Detached: the stack keeps running when the terminal goes away, and
    # the shell is free again. Use "./helper logs" to follow the output.
    compose up --build --force-recreate --detach
    echo "Stack started in the background. Follow it with: ./helper logs"
    ;;
"up-fg")
    # Same, but attached — for when you want the build and startup
    # output right here and Ctrl-C to stop the stack.
    compose rm -f
    compose up --build --force-recreate
    ;;
"start")
    compose start
    ;;
"stop")
    compose stop
    ;;
"restart")
    compose stop
    compose start
    ;;
"down")
    compose down --rmi local --remove-orphans
    ;;
"cmdbsyncer")
    shift
    "$RUNTIME" exec -it "$APPLICATION" ./cmdbsyncer "$@"
    ;;
"logs")
    echo "Start Container Logs"
    "$RUNTIME" logs -f "$APPLICATION"
    ;;
"shell")
    echo "Start Container Shell"
    # A login shell so /etc/profile runs — that is what loads tab
    # completion for the cmdbsyncer CLI. Older images have no bash.
    "$RUNTIME" exec -it "$APPLICATION" sh -c \
        'if command -v bash >/dev/null 2>&1; then exec bash -l; else exec sh -l; fi'
    ;;
"create_user")
    echo "Create User"
    "$RUNTIME" exec -it "$APPLICATION" ./cmdbsyncer sys create_user "${2:-}"
    ;;
"bve")
    python3 -m venv ENV
    ;;
*)
    echo "Simple Helper for CMDB Syncer Jobs."
    echo "Runtime: $RUNTIME (override with CONTAINER_RUNTIME=docker|podman)"
    echo "Commands: up (background), up-fg (attached), down, start, stop, restart,"
    echo "          logs, shell, cmdbsyncer, create_user EMAIL, bve"
    ;;
esac
